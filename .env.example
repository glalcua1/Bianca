# Google Gemini — required for AI atelier redesign sketches on the Golden Ratio Evaluation page
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Bianca Jewellery Purchase Plan (JPP)
# ---------------------------------------------------------------------------

# Supabase (recommended for production). Apply supabase/migrations/001_jpp_customers.sql
# Local/dev falls back to SQLite at database/jpp_customers.db when these are unset.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional public URL mirror (never put the service role key in VITE_ vars)
VITE_SUPABASE_URL=

# Admin portal (/admin) — required for dashboard access
JPP_ADMIN_EMAIL=
JPP_ADMIN_PASSWORD=
JPP_ADMIN_SESSION_SECRET=

# Contact (server + optional Vite public mirrors)
BIANCA_PHONE_NUMBER=+918130495257
BIANCA_WHATSAPP_NUMBER=918800995921
VITE_BIANCA_PHONE_NUMBER=+918130495257
VITE_BIANCA_WHATSAPP_NUMBER=918800995921

# Bank transfer details shown after registration
BIANCA_JPP_BANK_NAME=HDFC Bank
BIANCA_JPP_ACCOUNT_NUMBER=5278800615257
# Leave blank until the official HDFC IFSC is confirmed — do not invent a code
BIANCA_JPP_IFSC=
BIANCA_JPP_ACCOUNT_TYPE=Current
VITE_BIANCA_JPP_BANK_NAME=HDFC Bank
VITE_BIANCA_JPP_ACCOUNT_NUMBER=5278800615257
VITE_BIANCA_JPP_IFSC=
VITE_BIANCA_JPP_ACCOUNT_TYPE=Current

# Optional JPP number prefix (default: BIANCA-JPP → BIANCA-JPP-000001)
BIANCA_JPP_NUMBER_PREFIX=BIANCA-JPP
