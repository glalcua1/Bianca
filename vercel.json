{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/golden-ratio-analyze.js": {
      "maxDuration": 60,
      "excludeFiles": "{.venv-golden-ratio/**,scripts/golden_ratio/**}"
    },
    "api/exchange-rates.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
