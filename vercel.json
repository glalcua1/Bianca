{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/exchange-rates.js": {
      "maxDuration": 10
    }
  },
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "biancadiamonds.com"
        }
      ],
      "destination": "https://www.biancadiamonds.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "biancadiamonds.com"
        }
      ],
